# Docker image and port
ASR_IMAGE=local/asr-kit:cuda12
# ASR_IMAGE=ghcr.io/mishzorikhin/asr-kit:cuda12
# ASR_IMAGE=local/asr-kit:cpu
# ASR_IMAGE=ghcr.io/mishzorikhin/asr-kit:cpu
# ASR_IMAGE=local/asr-kit:arm64
# ASR_IMAGE=ghcr.io/mishzorikhin/asr-kit:arm64
ASR_PORT=8000

# Host paths mounted into the container
MODELS_CONFIG_FILE=./config/models.yaml
MODELS_DIR=./models
HF_CACHE_DIR=./hf-cache

# Runtime defaults (cuda + float16 for docker-compose.yml; cpu + int8 for docker-compose.cpu.yml / docker-compose.arm.yml)
DEFAULT_DEVICE=cuda
DEFAULT_COMPUTE_TYPE=float16
DEFAULT_LANGUAGE=ru
# OMP_NUM_THREADS=0  # 0 = all cores (docker-compose.cpu.yml); useful on AMD Ryzen/EPYC
LOG_LEVEL=INFO

# Model memory management
MODEL_IDLE_TTL_SECONDS=600
MODEL_UNLOAD_INTERVAL_SECONDS=30
MODEL_UNLOAD_AFTER_REQUEST=true

# Whisper in-process replica autoscaling (second concurrent request can spawn another WhisperModel)
WHISPER_AUTOSCALE_ENABLED=true
# Default: number of CUDA devices, or 2 on CPU. Set explicitly to cap VRAM use.
# WHISPER_MAX_REPLICAS=2
# Wait for a free replica when at max (seconds; 0 = wait forever)
WHISPER_REPLICA_WAIT_SECONDS=300
